// "hello world"
wf := import("@platforma-sdk/workflow-tengo:workflow")
ll := import("@platforma-sdk/workflow-tengo:ll")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
json := import("json")

filter := func(arr, predicate) {
	filtered := []
	for item in arr {
		if predicate(item) {
			filtered = append(filtered, item)
		}
	}
	return filtered
}

usage := import(":usage")

wf.prepare(func(args) {
	bundleBuilder := wf.createPBundleBuilder()
	bundleBuilder.ignoreMissingDomains() // to make query work for both bulk and single cell data
	bundleBuilder.addAnchor("main", args.datasetRef)

	// abundance
	bundleBuilder.addSingle({
		axes: [{ anchor: "main", idx: 0 }, { anchor: "main", idx: 1 }],
		annotations: {
			"pl7.app/isAbundance": "true",
			"pl7.app/abundance/normalized": "false",
			"pl7.app/abundance/isPrimary": "true"
		}
	}, "abundance")

	// Add the V and J gene hit columns to the bundle.
	for gene in ["V", "J"] {
		geneLower := gene == "V" ? "v" : "j"
		
		// Base domain for gene hit
		domain := {
			"pl7.app/vdj/reference": gene + "Gene"
		}
		
		// for single cell data, we will get multiple chains, so we need to add them all
		// and then pick ones we need when resolved
		bundleBuilder.addMulti({
			axes: [{ anchor: "main", idx: 1 }],
			name: args.allele ? "pl7.app/vdj/geneHitWithAllele" : "pl7.app/vdj/geneHit",
			domain: domain
		},
		geneLower + "Gene")
	}

	// Optional subset column picked alongside the dataset (PlDatasetSelector)
	if !is_undefined(args.inputFilter) {
		bundleBuilder.addRef(json.decode(args.inputFilter))
	}

	return { 
		columns: bundleBuilder.build()
	}
})

wf.body(func(args) {
	columns := args.columns
	// Paired when chains share one frame. MiXCR single-cell says so on the axis name; an imported
	// (variantKey) paired set says so only in the pl7.app/vdj/scClonotypeChain column domain.
	isSingleCell := args.columns.getSpec(args.datasetRef).axesSpec[1].name == "pl7.app/vdj/scClonotypeKey"
	for col in columns.getColumns("vGene") {
		if col.spec.domain["pl7.app/vdj/scClonotypeChain"] != undefined {
			isSingleCell = true
		}
	}

	vGeneCol := undefined
	jGeneCol := undefined
	if isSingleCell {
		predicate:= func(col) {
			return col.spec.domain["pl7.app/vdj/scClonotypeChain"] == args.scChain && col.spec.domain["pl7.app/vdj/scClonotypeChain/index"] == "primary"
		}
		vGeneCols := filter(columns.getColumns("vGene"), predicate)
		ll.assert(len(vGeneCols) == 1, "expected exactly 1 V gene column for chain, got %d", len(vGeneCols))
		vGeneCol = vGeneCols[0]
		
		jGeneCols := filter(columns.getColumns("jGene"), predicate)
		ll.assert(len(jGeneCols) == 1, "expected exactly 1 J gene column for chain, got %d", len(jGeneCols))
		jGeneCol = jGeneCols[0]
	} else {
		ll.assert(len(columns.getColumns("vGene")) == 1, "expected exactly 1 V gene column, got ", len(columns.getColumns("vGene")))
		ll.assert(len(columns.getColumns("jGene")) == 1, "expected exactly 1 J gene column, got ", len(columns.getColumns("jGene")))
		vGeneCol = columns.getColumns("vGene")[0]
		jGeneCol = columns.getColumns("jGene")[0]
	}

	
	vGeneSpec := vGeneCol.spec
	jGeneSpec := jGeneCol.spec
	abundanceSpec := columns.getSpec("abundance")

	// Optional subset: only its clonotypes enter the usage. The trace roots in the filter so
	// downstream labels name it.
	filterColumn := undefined
	traceSpec := columns.getSpec(args.datasetRef)
	if !is_undefined(args.inputFilter) {
		f := columns.getColumn(json.decode(args.inputFilter))
		filterColumn = { spec: f.spec, data: f.data }
		traceSpec = f.spec
	}

	tsv := undefined
	if is_undefined(filterColumn) {
		table := pframes.tsvFileBuilder()
		table.mem("16GiB") // @TODO: set based on the size of the input

		table.setAxisHeader("pl7.app/sampleId", "sample")
		table.setAxisHeader(abundanceSpec.axesSpec[1].name, "clonotypeKey")
		table.add(vGeneCol, {header: "vGene"})
		table.add(jGeneCol, {header: "jGene"})
		table.add(columns.getColumn("abundance"), {header: "abundance"})
		// buildForPT() (not build()) so the TSV carries a declared PTabler schema: column
		// types come from the p-column/axis specs instead of polars' CSV type inference.
		tsv = table.buildForPT()
	} else {
		// The abundance is the filtered primary and the genes fill its rows. Parquet keeps the
		// spec types, as buildForPT does for the TSV.
		table := pframes.tableBuilder("parquet").setColumnJoin("left")
		table.mem("16GiB")
		table.setAxisHeader("pl7.app/sampleId", "sample")
		table.setAxisHeader(abundanceSpec.axesSpec[1].name, "clonotypeKey")
		table.addPrimary("main", {
			__isPrimaryRef: "v1",
			column: columns.getColumn("abundance"),
			filter: filterColumn
		}, {header: "abundance"})
		table.addColumn(vGeneCol, {header: "vGene"})
		table.addColumn(jGeneCol, {header: "jGene"})
		tsv = { xsvType: "parquet", file: table.build() }
	}

	results := usage.calculateUsage(vGeneSpec, jGeneSpec, abundanceSpec, tsv)
	vjUsage := results.vjUsage
	vUsage := results.vUsage
	jUsage := results.jUsage

	// Make trace for provenance
	
	// Use block label if provided, otherwise fall back to allele/gene indicator
	blockLabel := args.customBlockLabel || ""
	traceLabel := blockLabel != "" ? blockLabel : "Gene Usage " + (args.allele ? "(allele)" : "(gene)")
	
	trace := pSpec.makeTrace(traceSpec,
		{
			type: "milaboratories.vj-gene-usage",
			importance: 45,
			label: traceLabel
		})

	// Trace, plus the subset stamp on a subset run (its outputs cover only the subset)
	exportSpec := func(spec) {
		s := trace.inject(spec)
		if !is_undefined(filterColumn) {
			s.domain["pl7.app/inputSubset"] = args.inputFilter
		}
		return s
	}

	pf := pframes.pFrameBuilder()
	for id, v in vjUsage {
		pf.add(id + "-vj", exportSpec(v.spec), v.data)
	}
	for id, v in vUsage {
		pf.add(id + "-v", exportSpec(v.spec), v.data)
	}
	for id, v in jUsage {
		pf.add(id + "-j", exportSpec(v.spec), v.data)
	}
	pf = pf.build()

	return {
		outputs: {
			pf: pframes.exportFrame(pf)
		},

		exports: {
			pf: pf
		}
	}
})

